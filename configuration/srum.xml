  <mapping data_type="srum_network_connectivity_usage">
    <name>Srum Network Connectivity Usage</name>
    <description
        >Each row is an SRUM network-connectivity interval associated with an application, user, interface, and layer-2 profile, with connection start time and duration. Use it to place application network availability on a timeline and correlate profiles or interfaces. It records connectivity duration, not remote endpoints, payloads, or proof of a specific communication.</description>
    <short_description>Shows SRUM network connection sessions with application, user, interface, profile, start time, and duration.</short_description>
    <category>Network</category>
    <default_date_pattern value='iso' />
    <default_parser value="String" />
    <timeline>
      <timeline_type value="Standard" />
      <source_type value="level" />
      <related_user include_field_name="false" field_separator=" - ">
        <output_name value="user_id" />
      </related_user>
      <description>
        <output_name value="app_id" />
        <output_name value="interface_luid" />
      </description>
      <additional_description>
        <output_name value="connected_time" />
      </additional_description>
    </timeline>
    <fields>
      <field input="AutoIncId" description="Auto-increment identifier of the SRUM record" output="incremental_id" parser="Int" />
      <field input="TimeStamp" description="Timestamp of the SRUM record" output="timestamp" parser="DateTime" />
      <field input="AppId" description="Identifier of the application" output="app_id" parser="String" qualifier="APP_ID" />
      <field
                input="UserId" description="Identifier (SID) of the user"
                output="user_id"
                parser="String"
                qualifier="USER_ID"
            />
      <field input="InterfaceLuid" output="interface_luid" parser="Int" />
      <field
                input="ConnectStartTime"
                output="connect_start_time"
                parser="DateTime"
            />
      <field input="ConnectedTime" output="connected_time" parser="Int" />
      <field input="L2ProfileId" output="l2_profile_id" parser="Int" />
      <field input="L2ProfileFlags" output="l2_profile_flags" parser="Int" />
    </fields>
  </mapping>
