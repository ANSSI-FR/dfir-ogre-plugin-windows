<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="Srum" file_encoding="UTF_8">
  <mapping data_type="srum_app_timeline">
    <name>Srum App Timeline</name>
    <description
        >Each row is a Windows SRUM application-timeline interval associated with an application and user, with focus duration, input, audio, network, disk, and CPU activity counters. Use it to compare application engagement and correlate resource activity over time. Counters are aggregated telemetry rather than individual actions, and coverage depends on SRUM retention.</description>
    <short_description>Shows per-application focus, input, audio, network, and duration statistics recorded by Windows SRUM.</short_description>
    <category>Services and Applications</category>
    <default_date_pattern value='iso' />
    <default_parser value="String" />
    <timeline>
      <timeline_type value="Standard" />
      <related_user include_field_name="false" field_separator=" - ">
        <output_name value="user_id" />
      </related_user>
      <description>
        <output_name value="app_id" />
      </description>
      <additional_description>
        <output_name value="in_focus_s" />
        <output_name value="duration_ms" />
      </additional_description>
    </timeline>
    <fields>
      <field input="AutoIncId" description="Auto-increment identifier of the SRUM record" output="incremental_id" parser="Int" />
      <field input="TimeStamp" description="Timestamp of the SRUM record" output="timestamp" parser="DateTime" />
      <field input="AppId" description="Identifier of the application" output="app_id" parser="String" qualifier="APP_ID" />
      <field
                input="UserId" description="Identifier (SID) of the user"
                output="user_id"
                parser="String"
                qualifier="USER_ID"
            />
      <field input="Flags" description="Flags associated with the usage record" output="flags" parser="Int" />
      <field input="InFocusS" description="Time the app spent as the in-focus (foreground) window, in seconds" output="in_focus_s" parser="Int" />
      <field input="DurationMS" description="Duration of the usage interval in milliseconds" output="duration_ms" parser="Int" />
      <field input="SpanMS" description="Time span covered by the interval in milliseconds" output="span_ms" parser="Int" />
      <field input="UserInputS" description="Time of user input activity, in seconds" output="user_input_s" parser="Int" />
      <field input="KeyboardInputS" description="Time of keyboard input activity, in seconds" output="keyboard_input_s" parser="Int" />
      <field input="MouseInputS" description="Time of mouse input activity, in seconds" output="mouse_input_s" parser="Int" />
      <field input="AudioInS" description="Time performing audio input, in seconds" output="audio_in_s" parser="Int" />
      <field input="AudioOutS" description="Time performing audio output, in seconds" output="audio_out_s" parser="Int" />
      <field input="DiskRaw" description="Raw disk usage count" output="disk_raw" parser="Int" />
      <field input="NetworkTailRaw" description="Raw network tail metric" output="network_tail_raw" parser="Int" />
      <field input="NetworkBytesRaw" description="Raw network bytes metric" output="network_bytes_raw" parser="Int" />

      <field input="PSMForegroundS" description="Time the process spent in foreground (Process State Manager), in seconds" output="pms_foreground_s" parser="Int" />
      <field input="CompRenderedS" description="Time composing rendered content, in seconds" output="comp_rendered_s" parser="Int" />
      <field input="CompDirtiedS" description="Time composing dirtied content, in seconds" output="comp_dirtied_s" parser="Int" />
      <field input="CompPropagatedS" description="Time composing propagated content, in seconds" output="comp_propagated_s" parser="Int" />
      <field input="Cycles" description="Total CPU cycles used" output="cycles" parser="Int" />
      <field input="CyclesBreakdown" description="CPU cycle usage breakdown" output="cycles_breakdown" parser="Int" />
      <field input="CyclesAttr" description="CPU cycles attributed to the process" output="cycles_attr" parser="Int" />
      <field
                input="CyclesAttrBreakdown" description="Breakdown of attributed CPU cycles"
                output="cycles_attr_breakdown"
                parser="Int"
            />
      <field input="CyclesWOB" description="CPU cycles used without over-budget accounting" output="cycles_wob" parser="Int" />
      <field
                input="CyclesWOBBreakdown" description="Breakdown of non-over-budget CPU cycles"
                output="cycles_wob_breakdown"
                parser="Int"
            />
      <field input="DiskRaw" description="Raw disk usage count" output="disk_raw" parser="Int" />
      <field input="NetworkTailRaw" description="Raw network tail metric" output="network_tail_raw" parser="Int" />
      <field input="NetworkBytesRaw" description="Raw network bytes metric" output="network_bytes_raw" parser="Int" />
      <field input="MBBTailRaw" description="Raw mobile broadband tail metric" output="mbb_tail_raw" parser="Int" />
      <field input="MBBBytesRaw" description="Raw mobile broadband bytes metric" output="mbb_bytes_raw" parser="Int" />
      <field
                input="DisplayRequiredS" description="Time the display was required to stay on, in seconds"
                output="display_required_s"
                parser="Int"
            />

      <field input="EndTime" description="End time of the usage interval" output="end_time" parser="Int" />
      <field input="TimelineEnd" description="End of the usage timeline data" output="timeline_end" parser="Int" />
      <field
                input="DisplayRequiredTimeline" description="Display-required timeline data"
                output="display_required_timeline"
                parser="Int"
            />
      <field
                input="KeyboardInputTimeline" description="Keyboard input timeline data"
                output="keyboard_input_timeline"
                parser="Int"
            />
      <field
                input="UserInputTimeline" description="User input timeline data"
                output="user_input_timeline"
                parser="Int"
            />
      <field
                input="CompRenderedTimeline" description="Composition rendered timeline data"
                output="comp_rendered_timeline"
                parser="Int"
            />
      <field
                input="CompDirtiedTimeline" description="Composition dirtied timeline data"
                output="comp_dirtied_timeline"
                parser="Int"
            />
      <field
                input="CompPropagatedTimeline" description="Composition propagated timeline data"
                output="comp_propagated_timeline"
                parser="Int"
            />
      <field input="AudioInTimeline" description="Audio input timeline data" output="audio_in_timeline" parser="Int" />
      <field
                input="AudioOutTimeline" description="Audio output timeline data"
                output="audio_out_timeline"
                parser="Int"
            />
      <field input="CpuTimeline" description="CPU usage timeline" output="cpu_timeline" parser="Int" />
      <field input="DiskTimeline" description="Disk usage timeline" output="disk_timeline" parser="Int" />
      <field input="NetworkTimeline" description="Network usage timeline" output="network_timeline" parser="Int" />
      <field input="MBBTimeline" description="Mobile broadband usage timeline" output="mbb_timeline" parser="Int" />
    </fields>
  </mapping>
  <mapping data_type="srum_application_resources">
    <name>Srum Application Resources</name>
    <description
        >Each row is a Windows SRUM resource-usage interval for an application and user, with foreground or background CPU cycles, context switches, and read, write, or flush counts. Use it to identify resource-intensive or previously observed applications and correlate usage over time. Aggregated counters do not reveal individual operations, and absence does not prove non-execution.</description>
    <short_description>Shows per-application CPU, I/O, foreground, and background resource usage over time from Windows SRUM.</short_description>
    <category>Services and Applications</category>
    <default_date_pattern value='iso' />
    <default_parser value="String" />
    <timeline>
      <timeline_type value="Standard" />
      <source_type value="level" />
      <related_user include_field_name="false" field_separator=" - ">
        <output_name value="user_id" />
      </related_user>
      <description>
        <output_name value="app_id" />
      </description>
      <additional_description>
        <output_name value="face_time" />
      </additional_description>
    </timeline>
    <fields>
      <field input="AutoIncId" description="Auto-increment identifier of the SRUM record" output="incremental_id" parser="Int" />
      <field input="TimeStamp" description="Timestamp of the SRUM record" output="timestamp" parser="DateTime" />
      <field input="AppId" description="Identifier of the application" output="app_id" parser="String" qualifier="APP_ID" />
      <field
                input="UserId" description="Identifier (SID) of the user"
                output="user_id"
                parser="String"
                qualifier="USER_ID"
            />

      <field input="FaceTime" output="face_time" parser="Int" />

      <field
                input="ForegroundCycleTime"
                output="foreground_cycle_time"
                parser="Int"
            />
      <field
                input="BackgroundCycleTime"
                output="background_cycle_time"
                parser="Int"
            />

      <field
                input="ForegroundContextSwitches"
                output="foreground_context_switches"
                parser="Int"
            />
      <field
                input="BackgroundContextSwitches"
                output="background_context_switches"
                parser="Int"
            />

      <field
                input="ForegroundBytesRead"
                output="foreground_bytes_read"
                parser="Int"
            />
      <field
                input="BackgroundBytesRead"
                output="background_bytes_read"
                parser="Int"
            />

      <field
                input="ForegroundBytesWritten"
                output="foreground_bytes_written"
                parser="Int"
            />
      <field
                input="BackgroundBytesWritten"
                output="background_bytes_written"
                parser="Int"
            />

      <field
                input="ForegroundNumReadOperations"
                output="foreground_num_read_operations"
                parser="Int"
            />
      <field
                input="BackgroundNumReadOperations"
                output="background_num_read_operations"
                parser="Int"
            />

      <field
                input="ForegroundNumWriteOperations"
                output="foreground_num_write_operations"
                parser="Int"
            />
      <field
                input="BackgroundNumWriteOperations"
                output="background_num_write_operations"
                parser="Int"
            />

      <field
                input="ForegroundNumberOfFlushes"
                output="foreground_number_of_flushes"
                parser="Int"
            />
      <field
                input="BackgroundNumberOfFlushes"
                output="background_number_of_flushes"
                parser="Int"
            />

    </fields>
  </mapping>
  <mapping data_type="srum_energy_estimation">
    <name>Srum Energy Estimation</name>
    <description>Each row preserves an SRUM energy-estimation record with timestamp, application and user identifiers, and an opaque binary payload. Use the identifiers and time for correlation or future schema-aware decoding. Because the payload is not interpreted by this mapping, it should not support claims about specific energy components or quantities.</description>
    <short_description>Preserves opaque per-application SRUM energy-estimation records with application, user, and timestamp context.</short_description>
    <category>Services and Applications</category>
    <default_date_pattern value='iso' />
    <default_parser value="String" />
    <timeline>
      <timeline_type value="Standard" />
      <source_type value="level" />
      <related_user include_field_name="false" field_separator=" - ">
        <output_name value="user_id" />
      </related_user>
      <description>
        <output_name value="app_id" />
      </description>
    </timeline>
    <fields>
      <field input="AutoIncId" description="Auto-increment identifier of the SRUM record" output="incremental_id" parser="Int" />
      <field input="TimeStamp" description="Timestamp of the SRUM record" output="timestamp" parser="DateTime" />
      <field input="AppId" description="Identifier of the application" output="app_id" parser="String" qualifier="APP_ID" />
      <field
                input="UserId" description="Identifier (SID) of the user"
                output="user_id"
                parser="String"
                qualifier="USER_ID"
            />
      <field input="BinaryData" output="binary_data" parser="String" />
    </fields>
  </mapping>
  <mapping data_type="srum_energy_usage">
    <name>Srum Energy Usage</name>
    <description
        >Each row is an SRUM battery or power-state event, with timestamp, state transition, designed or full capacity, charge level, cycle count, and configuration hash. Use it to reconstruct device power conditions around user or system activity. These are system energy-state records, not per-process consumption measurements.</description>
    <short_description>Shows SRUM battery energy events with state transitions, capacity, charge level, cycle count, and timestamps.</short_description>
    <category>Windows Artefacts</category>
    <category>Services and Applications</category>
    <default_date_pattern value='iso' />
    <default_parser value="String" />
    <timeline>
      <timeline_type value="Standard" />
      <source_type value="level" />
      <related_user include_field_name="false" field_separator=" - ">
        <output_name value="user_id" />
      </related_user>
      <description>
        <output_name value="app_id" />
      </description>
    </timeline>
    <fields>
      <field input="AutoIncId" description="Auto-increment identifier of the SRUM record" output="incremental_id" parser="Int" />
      <field input="TimeStamp" description="Timestamp of the SRUM record" output="timestamp" parser="DateTime" />
      <field input="AppId" description="Identifier of the application" output="app_id" parser="String" qualifier="APP_ID" />
      <field
                input="UserId" description="Identifier (SID) of the user"
                output="user_id"
                parser="String"
                qualifier="USER_ID"
            />
      <field input="EventTimestamp" output="EventTimestamp" parser="Int" />
      <field input="StateTransition" output="StateTransition" parser="Int" />
      <field input="DesignedCapacity" output="DesignedCapacity" parser="Int" />
      <field
                input="FullChargedCapacity"
                output="FullChargedCapacity"
                parser="Int"
            />
      <field input="ChargeLevel" output="ChargeLevel" parser="Int" />
      <field input="CycleCount" output="CycleCount" parser="Int" />
      <field
                input="ConfigurationHash"
                output="ConfigurationHash"
                parser="Int"
            />
    </fields>
  </mapping>
