<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="Csv" file_encoding="UTF_8">
  <mapping data_type="volstats">
    <name>Volstats</name>
    <description
    ><![CDATA[
Each row describes a volume observed by ORC, with host, volume identifier, mount point or device location, volume type, shadow-copy identifier, and indicators of which artifact sets were collected. Use it to map paths and records to the correct live volume or snapshot. It is collection metadata and does not itself represent file or user activity.
]]>
</description>
    <short_description>Shows Windows volumes with identifiers, mount points, types, locations, shadow-copy IDs, and collected artefact sets.</short_description>
    <category>File System</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='%Y-%m-%d %H:%M:%S.%3f' />
    <csv_delimiter value="," />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <description>
        <output_name value="mount_point" />
        <output_name value="volumeid" />
      </description>
      <additional_description>
        <output_name value="volume_type" />
        <output_name value="location" />
        <output_name value="shadow_copy" />
      </additional_description>
    </timeline>

    <fields>
      <field
        input="ComputerName"
        output="computer_name"
        parser="String"
        description="Host name that produced the volstat report"
      />
      <field
        input="VolumeID"
        output="volumeid"
        parser="String"
        description="Unique identifier (GUID) of the volume"
      />
      <field
        input="Location"
        output="location"
        parser="String"
        description="Physical location or drive letter of the volume"
      />
      <field
        input="Type"
        output="volume_type"
        parser="String"
        description="File system type (FAT, NTFS, etc.)"
      />
      <field input="Parse" output="is_parsed" parser="Bool" />
      <field
        input="MountPoint"
        output="mount_point"
        parser="String"
        description="Path where the volume is mounted"
      />
      <field
        input="ShadowCopyId"
        output="shadow_copy"
        parser="Python"
        description="Identifier of the associated VSS snapshot, if any"
      />
      <field
        input="FileInfo"
        output="fileinfo"
        parser="String"
        description="raw file‑information from the volume"
      />
      <field
        input="i30Info"
        output="i30info"
        parser="String"
        description="directory index ($I30) information for the volume"
      />
      <field
        input="AttrInfo"
        output="attrinfo"
        parser="String"
        description="NTFS attribute information for the volume"
      />
      <field
        input="Timeline"
        output="timeline"
        parser="String"
        description="timeline metadata (e.g., timestamps) associated with the volume"
      />
      <field
        input="SecDescr"
        output="secdescr"
        parser="String"
        description="security descriptor data for the volume"
      />
    </fields>
  </mapping>

</plugin>
