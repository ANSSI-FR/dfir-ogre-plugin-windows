<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="XML" file_encoding="UTF_8">
  <mapping data_type="amcache_program_xml">
    <name>Amcache Program Previous</name>
    <description
    >Each row is a program inventory entry from an AEINV PREVIOUS report, with program identity, version, publisher, source, paths, and related executable hashes where available. Use it to recover earlier inventory and correlate software across reports. Presence in the report does not by itself prove execution.</description>
    <short_description>Lists installed programs and executable hashes, paths, versions, vendors, and run evidence from AEINV_PREVIOUS.</short_description>
    <category>Services and Applications</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='%m/%d/%Y %H:%M:%S' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <description>
        <output_name value="name" />
      </description>
      <additional_description>
        <output_name value="version" />
        <output_name value="publisher" />
        <output_name value="source" />
      </additional_description>
    </timeline>

    <xpath_tuple value="//ProgramList/Program" />
    <fields>
        <field
        input="@Id"
        output="id"
        parser="String"
        qualifier="APP_ID"
        description="Program identifier"
      />

        <field
        input="@Name"
        output="name"
        parser="String"
        qualifier="APP_NAME"
        description="Program name"
      />

        <field
        input="@Version"
        output="version"
        parser="String"
        qualifier="PE_VERSION"
        description="Program version"
      />

        <field
        input="@Publisher"
        output="publisher"
        parser="String"
        qualifier="PUBLISHER"
        description="Program publisher"
      />

        <field
        input="@Source"
        output="source"
        parser="String"
        description="Installation method ('MSI', 'AppxPackage', 'AddRemoveProgram')"
      />

        <array>
            <object
          input="Indicators/RegistryIndicators/Registry"
          output="indicators"
        >
                <field input="@Name" description="File name" output="name" parser="String" />
                <field input="@File" description="File path from the static property" output="file" parser="String" />
                <field input="@RegistryRun" description="Registry key/value that launched the program" output="run" parser="String" />
            </object>
        </array>
        <array>
            <object input="StaticProperties/Files/File" output="files">
                <field input="@Name" description="File name" output="name" parser="String" />
                <field input="@Id" description="SHA-1 hash of the file" output="sha1" parser="String" />
                <field
            input="@Size" description="File size in bytes"
            output="size"
            parser="IntRadix"
            radix="16"
          />
                <field input="@ProductName" description="Product name" output="product" parser="String" />
                <field input="@CompanyName" description="Company (vendor) name" output="company" parser="String" />
                <field
            input="@ProductVersion" description="Product version"
            output="product_version"
            parser="String"
          />
                <field
            input="@VerLanguage" description="Language code of the file"
            output="version_language"
            parser="String"
          />
                <field
            input="@FileVersion" description="File version number"
            output="file_version"
            parser="String"
          />
                <field
            input="@SizeOfImage" description="Size of the executable image in bytes"
            output="image_size"
            parser="IntRadix"
            radix="16"
          />
                <field
            input="@FileDescription" description="File description string"
            output="file_description"
            parser="String"
          />
                <field
            input="@LinkerVersion" description="PE linker version"
            output="linker_version"
            parser="String"
          />
                <field input="@LinkDate" description="PE link (compilation) date" output="link_date" parser="DateTime" />
                <field
            input="@BinaryType" description="PE binary type (exe, dll, driver)"
            output="binary_type"
            parser="String"
          />
                <field input="@Created" description="File creation timestamp" output="created" parser="DateTime" />
                <field input="@Modified" description="File modification timestamp" output="modified" parser="DateTime" />
                <field
            input="@LongPathHash" description="Hash of the long path storing the file"
            output="long_path_hash"
            parser="String"
          />
                <field input="@UniqueId" description="Unique identifier of the file entry" output="unique_id" parser="String" />
            </object>
        </array>
    </fields>
  </mapping>
</plugin>
