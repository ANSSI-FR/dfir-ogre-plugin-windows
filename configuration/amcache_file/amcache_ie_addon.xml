<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="XML" file_encoding="UTF_8">
  <mapping data_type="amcache_ie_addon_xml">
    <name>Amcache Ie Addon Xml</name>
    <description
    >Each row identifies an Internet Explorer add-on found in an Amcache XML report, including its identifier, name, type, and publisher. Use it to inventory browser integrations and pivot on suspicious publishers or identifiers. Report presence does not show that the add-on was enabled or used.</description>
    <short_description>Lists Internet Explorer add-on identifiers, names, types, and publishers from Amcache XML reports.</short_description>
    <category>Services and Applications</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='%m/%d/%Y %H:%M:%S' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <description>
        <output_name value="name" />
      </description>
      <additional_description>
        <output_name value="type" />
        <output_name value="publisher" />
        <output_name value="id" />
      </additional_description>
    </timeline>

    <xpath_tuple value="//IEAddOn" />
    <fields>
        <field
        input="@CLSID"
        output="id"
        parser="Python"
        qualifier="APP_ID"
        description="Program identifier"
      />

        <field
        input="@Name"
        output="name"
        parser="String"
        qualifier="APP_NAME"
        description="Program name"
      />

        <field
        input="@Type"
        output="type"
        parser="String"
        description="AddOn type"
      />

        <field
        input="@Publisher"
        output="publisher"
        parser="String"
        qualifier="PUBLISHER"
        description="Program publisher"
      />

    </fields>
  </mapping>
</plugin>
