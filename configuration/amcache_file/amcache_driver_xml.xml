<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="XML" file_encoding="UTF_8">
  <mapping data_type="amcache_driver_xml">
    <name>Amcache Driver Xml</name>
    <description>Each row is a driver inventory entry extracted from an Amcache XML report, with hash, name, version, vendor, size, and compilation metadata. Use these attributes to identify unusual or vulnerable drivers and correlate binaries across hosts. Inventory presence does not establish that the driver loaded or executed.</description>
    <short_description>Lists driver hashes, names, versions, vendors, sizes, and compilation metadata from Amcache XML reports.</short_description>
    <category>Services and Applications</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='%m/%d/%Y %H:%M:%S' />
    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <description>
        <output_name value="name" />
      </description>
      <additional_description>
        <output_name value="product" />
        <output_name value="company" />
      </additional_description>
    </timeline>
    <xpath_tuple value="//Driver" />
    <fields>
        <field input="@DriverId" description="SHA-1 hash of the driver binary" output="sha1" parser="String" />
        <field input="@Name" description="Driver name" output="name" parser="String" />
        <field input="@Type" description="Driver type (e.g. Kernel, File System)" output="type" parser="String" />
        <field input="@Version" description="Driver version" output="version" parser="String" />
        <field
        input="@TimeStamp" description="Driver compilation/link timestamp"
        output="compilation_date"
        parser="DateTime"
        date_codec="timestamp_hex"
      />
        <field input="@CheckSum" description="Driver image checksum" output="checksum" parser="String" />
        <field
        input="@ImageSize" description="Driver binary size in bytes"
        output="image_size"
        parser="IntRadix"
        radix="16"
      />
        <field input="@Company" description="Driver vendor/company name" output="company" parser="String" />
        <field input="@Product" description="Driver product name" output="product" parser="String" />
        <field
        input="@ProductVersion" description="Driver product version"
        output="product_version"
        parser="String"
      />
        <field input="@WdfVersion" description="Windows Driver Framework version" output="wdf_version" parser="String" />
    </fields>
  </mapping>
</plugin>
