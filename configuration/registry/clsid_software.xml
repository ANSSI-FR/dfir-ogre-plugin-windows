<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="RegClsIdSoftware" file_encoding="UTF_8">
  <mapping data_type="clsid">
    <name>CLSID Software</name>
    <description
    ><![CDATA[
Each row is a machine-wide COM class registration, with CLSID, description, implementing executable or DLL, TreatAs redirection, and registry provenance. Use it to hunt COM hijacking or persistence by comparing handlers and redirects with expected baselines. Registration alone does not prove that the COM object was instantiated or its code loaded.
]]>
    </description>
    <short_description>Shows machine-wide COM registrations with CLSIDs, descriptions, executables, redirects, and registry metadata.</short_description>
    <category>Windows Artefacts</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='iso' />


    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <related_user>
        <output_name value="key_security.owner_sid" />
      </related_user>
      <description>
        <output_name value="description" />
      </description>
      <additional_description>
        <output_name value="executable" />
        <output_name value="treat_as" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
        input="guid"
        parser="String"
        qualifier="APP_CLSID"
        description="lower‑cased CLSID identifying the COM class"
      />

      <field
        input="description"
        parser="String"
        description="human‑readable description of the COM class"
      />

      <field
        input="executable"
        parser="String"
        qualifier="FILE_PATH"
        description="path(s) to the binary(ies) implementing the CLSID (e.g., InprocServer32, LocalServer32)"
      />

      <field
        input="treat_as"
        parser="String"
        qualifier="APP_CLSID"
        description="CLS ID that this entry redirects to via TreatAs"
      />

      <!-- Registry Key data-->
      <field
        input="key_path"
        parser="String"
        qualifier="KEY_PATH"
        description="full registry key name"
      />
      <field
        input="key_modif_time"
        parser="DateTime"
        qualifier="DATE_MODIFICATION"
        display_name="Registry key last modification"
        description="last modification timestamp of the registry key"
      />
      <object input="key_security">
        <field
          input="owner_sid"
          parser="String"
          qualifier="USER_SID"
          description="SID of the user that owns the registry key"
        />
        <field
          input="group_sid"
          parser="String"
          description="SID of the group that owns the registry key"
        />
        <array>
          <field
            input="control_flags"
            parser="String"
            description="security descriptor control flags for the key"
          />
        </array>
        <array>
          <object input="sacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
        <array>
          <object input="dacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
      </object>
    </fields>
  </mapping>

</plugin>
