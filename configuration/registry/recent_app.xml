<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="RegRecentApp" file_encoding="UTF_8">
  <mapping data_type="recent_app">
    <description
    ><![CDATA[
Each row describes an application or recent item from the short-lived Windows 10 RecentApps artifact, with program identity, launch count, last access time, file path, and arguments where available. Use it to associate applications with recently accessed files. The artifact is limited to Windows 10 versions 1607 through 1709, has finite retention, and absence does not exclude use.
]]>
    </description>
    <short_description>Shows Windows RecentApps launch counts and access times plus recently used file paths and arguments.</short_description>
    <category>Services and Applications</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='iso' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <related_user>
        <output_name value="key_security.owner_sid" />
      </related_user>
      <description>
        <output_name value="path" />
      </description>
      <additional_description>
        <output_name value="launch_count" />
        <output_name value="display_name" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
        input="guid_app"
        parser="String"
        description="GUID of the application"
      />

      <field
        input="app_id"
        parser="String"
        qualifier="APP_ID"
        description="Application identifier"
      />

      <field
        input="app_path"
        parser="String"
        qualifier="PATH"
        description="Path of the application executable"
      />

      <field
        input="launch_count"
        parser="Int"
        description="Number of times the application has been launched"
      />

      <field
        input="app_last_accessed_time"
        parser="DateTime"
        qualifier="DATE_ACCESS"
        display_name="Application last access"
        description="Timestamp of the last time the application was accessed"
      />

      <field
        input="guid_file"
        parser="String"
        description="GUID of the recently accessed file"
      />

      <field
        input="display_name"
        parser="String"
        description="Human‑readable display name of the recent file"
      />

      <field
        input="path"
        parser="String"
        description="Path of the recently accessed item"
      />

      <field
        input="arguments"
        parser="String"
        description="Optional arguments associated with the recently accessed item"
      />

      <field
        input="file_last_accessed_time"
        parser="DateTime"
        qualifier="DATE_ACCESS"
        display_name="File last access"
        description="Timestamp of the last time the file was accessed"
      />

      <!-- Registry Key data-->
      <field
        input="key_path"
        parser="String"
        qualifier="KEY_PATH"
        description="full registry key name"
      />
      <field
        input="key_modif_time"
        parser="DateTime"
        qualifier="DATE_MODIFICATION"
        display_name="Registry key last modification"
        description="last modification timestamp of the registry key"
      />
      <object input="key_security">
        <field
          input="owner_sid"
          parser="String"
          qualifier="USER_SID"
          description="SID of the user that owns the registry key"
        />
        <field
          input="group_sid"
          parser="String"
          description="SID of the group that owns the registry key"
        />
        <array>
          <field
            input="control_flags"
            parser="String"
            description="security descriptor control flags for the key"
          />
        </array>
        <array>
          <object input="sacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
        <array>
          <object input="dacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
      </object>
    </fields>
  </mapping>

</plugin>
