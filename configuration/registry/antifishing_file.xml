<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="RegAntifishingFile" file_encoding="UTF_8">
  <mapping data_type="antifishing_file">
    <description
    ><![CDATA[
Each row exposes the Internet Explorer anti-phishing UserFile registry setting for a user, with its configured value, key path, LastWrite time, owner, and access controls. Use it to locate related browser-protection data and assess unexpected configuration changes. The setting alone does not describe the file contents or prove that Internet Explorer consumed it.
]]>
    </description>
    <short_description>Shows the Internet Explorer anti-phishing user file with registry path, timestamp, owner, and access controls.</short_description>
    <category>Application Specific</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='iso' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <related_user>
        <output_name value="key_security.owner_sid" />
      </related_user>
      <description>
        <output_name value="user_file" />
      </description>
      <additional_description>
        <output_name value="key_path" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
        input="user_file"
        parser="String"
        qualifier="FILE_PATH"
        description="Path to the file used by Internet Explorer's anti‑phishing feature"
      />

      <!-- Registry Key data-->
      <field
        input="key_path"
        parser="String"
        qualifier="KEY_PATH"
        description="full registry key name"
      />
      <field
        input="key_modif_time"
        parser="DateTime"
        qualifier="DATE_MODIFICATION"
        display_name="Registry key last modification"
        description="last modification timestamp of the registry key"
      />
      <object input="key_security">
        <field
          input="owner_sid"
          parser="String"
          qualifier="USER_SID"
          description="SID of the user that owns the registry key"
        />
        <field
          input="group_sid"
          parser="String"
          description="SID of the group that owns the registry key"
        />
        <array>
          <field
            input="control_flags"
            parser="String"
            description="security descriptor control flags for the key"
          />
        </array>
        <array>
          <object input="sacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
        <array>
          <object input="dacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
      </object>
    </fields>
  </mapping>

</plugin>
