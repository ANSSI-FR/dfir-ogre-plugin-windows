<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="RegUserAssist" file_encoding="UTF_8">
  <mapping data_type="user_assist">
    <description
    ><![CDATA[
Each row is a per-user UserAssist record for a GUI-launched item, with decoded path or name, run count, focus metrics, launch type, last-run time, and registry provenance. Use it as execution evidence and correlate user-attributed launches with files and other timelines. Counter semantics vary by format and Windows version, and absence does not exclude execution by other mechanisms.
]]>
    </description>
    <short_description>Shows per-user program execution counts, focus metrics, launch types, last-run times, and registry provenance.</short_description>
    <category>Services and Applications</category>

    <default_parser value="Ignore" />
    <default_date_pattern value='iso' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <related_user>
        <output_name value="key_security.owner_sid" />
      </related_user>
      <description>
        <output_name value="program_name" />
      </description>
      <additional_description>
        <output_name value="run" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
        input="program_name"
        parser="String"
        description="decoded name of the executed program or known‑folder path"
      />

      <field
        input="launch_type"
        parser="String"
        description="type of launch for legacy UserAssist entries (e.g., UEME)"
      />

      <field
        input="run"
        parser="Int"
        description="total number of times the program was executed"
      />

      <field
        input="focus_count"
        parser="Int"
        description="number of times the program window received focus"
      />

      <field
        input="focus_time"
        parser="String"
        description="cumulative focus duration (formatted as a time delta)"
      />

      <field
        input="session"
        parser="Int"
        description="identifier of the logon session in which the program ran"
      />

      <field
        input="last_executed"
        parser="DateTime"
        qualifier="DATE_LAST_RUN"
        display_name="Last execution date"
        description="timestamp of the most recent execution of the program"
      />

      <!-- Registry Key data-->
      <field
        input="key_path"
        parser="String"
        qualifier="KEY_PATH"
        description="full registry key name"
      />
      <field
        input="key_modif_time"
        parser="DateTime"
        qualifier="DATE_MODIFICATION"
        display_name="Registry key last modification"
        description="last modification timestamp of the registry key"
      />
      <object input="key_security">
        <field
          input="owner_sid"
          parser="String"
          qualifier="USER_SID"
          description="SID of the user that owns the registry key"
        />
        <field
          input="group_sid"
          parser="String"
          description="SID of the group that owns the registry key"
        />
        <array>
          <field
            input="control_flags"
            parser="String"
            description="security descriptor control flags for the key"
          />
        </array>
        <array>
          <object input="sacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
        <array>
          <object input="dacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
      </object>
    </fields>
  </mapping>
</plugin>
