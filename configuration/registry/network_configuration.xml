<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="RegNetworkConfig" file_encoding="UTF_8">
  <mapping data_type="network_config">
    <name>Network Configuration</name>
    <description
    ><![CDATA[
Each row describes a Windows network-interface configuration from the SYSTEM hive, including interface identity, IP address, mask, gateway, DHCP and DNS values, plus registry provenance. Use it to establish host network context and correlate addresses with logs or captures. Settings can be historical, stale, or lease-derived and do not represent network traffic.
]]>
    </description>
    <short_description>Shows Windows IP, mask, gateway, DHCP, DNS, interface, registry ownership, and configuration timestamps.</short_description>
    <category>System Information</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='iso' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <related_user>
        <output_name value="key_security.owner_sid" />
      </related_user>
      <description>
        <output_name value="ip_address" />
        <output_name value="dns_suffix" />
        <output_name value="dhcp" />
      </description>
      <additional_description>
        <output_name value="network_mask" />
        <output_name value="gateway" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
        input="ip_address"
        parser="String"
        qualifier="IP_ADDRESS"
        description="IP address assigned to the network interface"
      />

      <field
        input="network_mask"
        parser="String"
        description="Subnet mask associated with the IP address"
      />

      <field
        input="dhcp"
        parser="Bool"
        description="Indicates whether the interface obtains its configuration via DHCP (true = DHCP enabled)"
      />

      <field
        input="dhcp_server"
        parser="String"
        description="Address of the DHCP server that provided the configuration"
      />

      <field
        input="dns_suffix"
        parser="String"
        description="DNS suffix (domain) applied to the interface"
      />

      <field
        input="name_servers"
        parser="String"
        description="Comma‑separated list of DNS name‑server addresses"
      />

      <field
        input="gateway"
        parser="String"
        description="Default gateway IP address for the interface"
      />

      <!-- Registry Key data-->
      <field
        input="key_path"
        parser="String"
        qualifier="KEY_PATH"
        description="full registry key name"
      />
      <field
        input="key_modif_time"
        parser="DateTime"
        qualifier="DATE_MODIFICATION"
        display_name="Registry key last modification"
        description="last modification timestamp of the registry key"
      />
      <object input="key_security">
        <field
          input="owner_sid"
          parser="String"
          qualifier="USER_SID"
          description="SID of the user that owns the registry key"
        />
        <field
          input="group_sid"
          parser="String"
          description="SID of the group that owns the registry key"
        />
        <array>
          <field
            input="control_flags"
            parser="String"
            description="security descriptor control flags for the key"
          />
        </array>
        <array>
          <object input="sacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
        <array>
          <object input="dacl_aces" ignore="false">
            <field
              input="ace_type"
              parser="String"
              description="type of ACE (e.g., allow, deny)"
            />
            <array>
              <field
                input="ace_flags"
                parser="String"
                description="ACE flags that modify inheritance or behavior"
              />
            </array>
            <array>
              <field
                input="rights"
                parser="String"
                description="permissions granted or denied by the ACE"
              />
            </array>
            <field
              input="account_sid"
              parser="String"
              description="SID of the account the ACE applies to"
            />
            <field
              input="ace_size"
              parser="Int"
              description="declared ACE size in bytes"
            />
            <field
              input="object_type_guid"
              parser="String"
              description="GUID identifying the object type governed by the ACE"
            />
            <field
              input="inherited_object_type_guid"
              parser="String"
              description="GUID identifying the inherited object type governed by the ACE"
            />
            <field
              input="raw_hex"
              parser="String"
              description="raw ACE bytes preserved as hexadecimal"
            />
          </object>
        </array>
      </object>
    </fields>
  </mapping>

</plugin>
