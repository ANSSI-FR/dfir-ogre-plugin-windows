<?xml version="1.0" encoding="UTF-8" ?>
<plugin parser="IeWebCache" file_encoding="UTF_8">
  <mapping data_type="ie_webcache_history">
    <description
        ><![CDATA[
Extracts browsing history records from Internet Explorer 10+ WebCache databases (WebCacheV01.dat).
The plugin queries the Containers and Container_X tables to retrieve URL visits with metadata.

- Url provides the visited web address.
- Filename and FileExtension indicate cached file details.
- Timestamps (SyncTime, CreationTime, ExpiryTime, ModifiedTime, AccessedTime) show activity timeline.
- AccessCount and SyncCount reveal frequency and synchronization patterns.
]]>
    </description>
    <short_description>Shows Internet Explorer WebCache visits with URLs, cached files, timestamps, access counts, headers, and redirects.</short_description>
    <category>Browser Artefacts</category>
    <default_parser value="Ignore" />
    <default_date_pattern value='timestamp' />

    <!-- Timeline definition -->
    <timeline>
      <timeline_type value="Standard" />
      <description>
        <output_name value="url" />
      </description>
      <additional_description>
        <output_name value="filename" />
        <output_name value="access_count" />
        <output_name value="file_size" />
      </additional_description>
    </timeline>

    <!-- Fields -->
    <fields>
      <field
                input="file_size"
                parser="Int"
                description="Size of the cached file in bytes"
            />

      <field
                input="type"
                parser="Int"
                description="Record type identifier from WebCache"
            />

      <field
                input="flags"
                parser="Int"
                description="Flags associated with the cache entry"
            />

      <field
                input="access_count"
                parser="Int"
                description="Number of times this URL was accessed"
            />

      <field
                input="sync_count"
                parser="Int"
                description="Number of synchronization operations for this entry"
            />

      <field
                input="exemption_delta"
                parser="Int"
                description="Time offset exemption delta in seconds"
            />

      <field input="url" parser="String" description="Visited URL" />

      <field
                input="filename"
                parser="String"
                description="Cached file name (if applicable)"
            />

      <field
                input="file_extension"
                parser="String"
                description="File extension of the cached resource"
            />

      <field
                input="redirect_url"
                parser="String"
                description="Redirect target URL (if any)"
            />

      <field
                input="request_headers"
                parser="String"
                description="HTTP request headers (hex encoded)"
            />

      <array>
        <object input="response_properties">
          <field
                    input="store_index"
                    parser="Int"
                    description="Zero-based serialized property store index"
                />
          <field
                    input="storage_index"
                    parser="Int"
                    description="Zero-based property storage index within the store"
                />
          <field
                    input="format_id"
                    parser="String"
                    description="Property set format identifier (FMTID)"
                />
          <field
                    input="id"
                    parser="Int"
                    description="Property identifier within the property set"
                />
          <field
                    input="name"
                    parser="String"
                    description="Known symbolic property name, when available"
                />
          <field
                    input="value_type"
                    parser="String"
                    description="Windows variant property type"
                />
          <field
                    input="value"
                    parser="String"
                    description="Decoded property value represented as a string"
                />
        </object>
      </array>

      <field
                input="response_properties_raw"
                parser="String"
                description="Original serialized response properties (hex encoded)"
            />

      <field
                input="response_properties_parse_error"
                parser="String"
                description="Non-fatal errors encountered while decoding response properties"
            />

      <field
                input="group"
                parser="String"
                description="Cache group identifier (hex encoded)"
            />

      <field
                input="sync_date"
                parser="DateTime"
                display_name="Sync Date"
                description="Last synchronization time in UTC"
            />

      <field
                input="creation_date"
                parser="DateTime"
                qualifier="DATE_CREATION"
                display_name="Creation Date"
                description="Entry creation timestamp in UTC"
            />

      <field
                input="expiry_date"
                parser="DateTime"
                display_name="Expiry Date"
                description="Expiration timestamp in UTC"
            />

      <field
                input="modified_date"
                parser="DateTime"
                qualifier="DATE_MODIFICATION"
                display_name="Modified Date"
                description="Last modification timestamp in UTC"
            />

      <field
                input="accessed_date"
                parser="DateTime"
                qualifier="DATE_ACCESS"
                display_name="Accessed Date"
                description="Last access timestamp in UTC"
            />

      <field
                input="post_check_date"
                parser="DateTime"
                display_name="Post Check Date"
                description="Time of last post-check validation in UTC"
            />
    </fields>
  </mapping>
</plugin>
